    -- ============================================================
    local function makeSliderRow(parent, text, min, max, default, decimals, callback)
        local row = Instance.new("Frame", parent)
        row.Size = UDim2.new(1, 0, 0, 48 * SCALE)
        row.BackgroundColor3 = C_ROW
        row.BackgroundTransparency = 0.32
        row.BorderSizePixel = 0
        corner(row, 6 * SCALE)
        stroke(row)

        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(0.65, 0, 0, 20 * SCALE)
        lbl.Position = UDim2.new(0, 8 * SCALE, 0, 3 * SCALE)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12 * SCALE
        lbl.TextColor3 = C_TEXT
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local valLbl = Instance.new("TextLabel", row)
        valLbl.Size = UDim2.new(0, 60 * SCALE, 0, 20 * SCALE)
        valLbl.Position = UDim2.new(1, -68 * SCALE, 0, 3 * SCALE)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = tostring(default)
        valLbl.Font = Enum.Font.Gotham
        valLbl.TextSize = 12 * SCALE
        valLbl.TextColor3 = C_ACCENT
        valLbl.TextXAlignment = Enum.TextXAlignment.Right

        local track = Instance.new("Frame", row)
        track.Size = UDim2.new(1, -16 * SCALE, 0, 4 * SCALE)
        track.Position = UDim2.new(0, 8 * SCALE, 0, 33 * SCALE)
        track.BackgroundColor3 = C_TRACK
        track.BackgroundTransparency = 0.1
        track.BorderSizePixel = 0
        corner(track, 999)

        local pct0 = math.clamp((default - min) / (max - min), 0, 1)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new(pct0, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        fill.BorderSizePixel = 0
        corner(fill, 999)
        local fg = Instance.new("UIGradient", fill)
        fg.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(110, 20, 28)),
            ColorSequenceKeypoint.new(1, C_ACCENT),
        }

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.new(0, 20 * SCALE, 0, 9 * SCALE)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.AnchorPoint = Vector2.new(pct0, 0.5)
        knob.Position = UDim2.new(pct0, 0, 0.5, 0)
        knob.BorderSizePixel = 0
        corner(knob, 999)
        local ks = Instance.new("UIStroke", knob)
        ks.Color = C_ACCENT; ks.Thickness = 1; ks.Transparency = 0.15
        ks.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        local dragging = false
        local function fmt(v)
            if decimals and decimals > 0 then
                return string.format("%." .. decimals .. "f", v)
            end
            return tostring(math.floor(v + 0.5))
        end

        local function update(x)
            local pos  = track.AbsolutePosition.X
            local size = track.AbsoluteSize.X
            local pct  = math.clamp((x - pos) / size, 0, 1)
            local raw  = min + pct * (max - min)
            local val
            if decimals and decimals > 0 then
                local m = 10 ^ decimals
                val = math.floor(raw * m + 0.5) / m
            else
                val = math.floor(raw + 0.5)
            end
            val = math.clamp(val, min, max)
            local vp = (val - min) / (max - min)
            fill.Size = UDim2.new(vp, 0, 1, 0)
            knob.AnchorPoint = Vector2.new(vp, 0.5)
            knob.Position = UDim2.new(vp, 0, 0.5, 0)
            valLbl.Text = fmt(val)
            if callback then callback(val) end
        end

        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(i.Position.X)
            end
        end)
        knob.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
                update(i.Position.X)
            end
        end)

        return row, function(v)
            local vp = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(vp, 0, 1, 0)
            knob.AnchorPoint = Vector2.new(vp, 0.5)
            knob.Position = UDim2.new(vp, 0, 0.5, 0)
            valLbl.Text = fmt(v)
        end
    end

