local function toggleSpeedState(forceState)
    local newState
    if type(forceState) == "boolean" then
        newState = forceState
    else
        newState = not speedEnabled
    end

    -- Carpet Speed (Q) and Speed Booster share the same movement channel.
    -- If the booster was already on, suspend it while Q is active and restore
    -- it automatically when Q is turned back off.
    if newState and not speedEnabled and speedBoosterEnabled then
        speedBoosterWasSuspendedByCarpet = true
        if _G.XKPubSetSpeedBoosterEnabled then
            pcall(_G.XKPubSetSpeedBoosterEnabled, false)
        end
    end

    speedEnabled = newState
    carpetSpeedEnabled = newState
    _G._SammyCarpetSpeedEnabled = speedEnabled

    if persistFeature then
        pcall(function()
            persistFeature("carpetSpeedEnabled", speedEnabled)
        end)
    end

    if speedEnabled then
        local char = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")

        if char and backpack then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.Name ~= selectedGearItem then
                    pcall(function()
                        tool.Parent = backpack
                    end)
                end
            end
        end

        task.defer(function()
            equipSelectedTool()
        end)
        startEquipCheck()
        applyVelocity()
    else
        stopEquipCheck()
        stopVelocity()

        if speedBoosterWasSuspendedByCarpet then
            speedBoosterWasSuspendedByCarpet = false
            if _G.XKPubSetSpeedBoosterEnabled then
                pcall(_G.XKPubSetSpeedBoosterEnabled, true)
            end
        end
    end

    refreshSpeedVisual()
end

