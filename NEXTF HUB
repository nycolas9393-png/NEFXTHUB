    -- ============================================================
    _G.VX_autoRLast, _G.VX_autoRDir, _G.VX_autoRNext = 210, 1, 0
    local _vxAutoRotateConn = RunService.Heartbeat:Connect(function()
        if _G.AutoRotateInvis then
            if _G.invisibleStealEnabled == true then
                local now = tick()
                if now >= _G.VX_autoRNext then
                    _G.VX_autoRLast = _G.VX_autoRLast + _G.VX_autoRDir * 2
                    if _G.VX_autoRLast >= 225 then _G.VX_autoRLast = 225; _G.VX_autoRDir = -1
                    elseif _G.VX_autoRLast <= 195 then _G.VX_autoRLast = 195; _G.VX_autoRDir = 1 end
                    _G.VX_autoRLast = math.clamp(_G.VX_autoRLast, 180, 360)
                    _G.VX_autoRNext = now + 0.15
                end
                _G.CurrentInvisRotation = _G.VX_autoRLast
            else
                _G.VX_autoRLast, _G.VX_autoRDir, _G.VX_autoRNext = 210, 1, 0
                _G.CurrentInvisRotation = 210
            end
        else
            _G.CurrentInvisRotation = nil
        end
    end)

