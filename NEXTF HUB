    makeSliderRow(container, "Invis Depth • 5.0 for better experience", DEPTH_MIN, DEPTH_MAX, _G.SinkSliderValue, 1, function(v)
        _G.SinkSliderValue = v
    end)

    -- padding
    local pad = Instance.new("Frame", container)
    pad.Size = UDim2.new(1, 0, 0, 12)
    pad.BackgroundTransparency = 1
    pad.LayoutOrder = 1000

    -- ============================================================
    --  DONE
    -- ============================================================
    print("[NEXTF HUB] Invisible Steal + Control Panel red loaded.")
    print("     _G.toggleInvisibleSteal()   -> liga/desliga")
    print("     _G.InvisStealAngle          -> rotação (180..360)")
    print("     _G.SinkSliderValue          -> profundidade (5..10)")
    print("     _G.AutoRotateInvis          -> rotação automática")
    print("     _G.AutoInvisDuringSteal     -> liga sozinho no steal")

    _G.__SammyVxCleanup = function()
        _G.VXInvisLoopAlive = false
