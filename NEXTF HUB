local selectedPlayerCount = 3

local function findServer()
    task.spawn(function()
        local servers = {}
        local cursor = ""
        repeat
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
            local ok, response = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
            if not ok or not response or not response.data then break end
            for _, server in ipairs(response.data) do
                if server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    local playersInServer = tonumber(server.playing)
                    if playersInServer and playersInServer <= selectedPlayerCount then
                        table.insert(servers, server)
                    end
                end
            end
            cursor = response.nextPageCursor
        until #servers > 0 or not cursor or cursor == ""
        if #servers > 0 then
            table.sort(servers, function(a,b) return a.playing < b.playing end)
            local amount = math.min(3,#servers)
            local target = servers[math.random(1,amount)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
        end
    end)
end

-- ============================================================
-- EMPTY SERVER FINDER
-- ============================================================
-- Roblox's public-server endpoint does not expose a server country/region.
-- The finder therefore uses low population + the lowest reported server ping
-- as a Brazil-oriented heuristic; it cannot guarantee a Brazilian datacenter.

local emptyFinderBusy = false
local emptyFinderTarget = nil

local function getPublicServersForFinder()
    local servers = {}
    local cursor = ""
    local pages = 0

    repeat
        pages += 1
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or type(response) ~= "table" or type(response.data) ~= "table" then
            break
        end

        for _, server in ipairs(response.data) do
            local playing = tonumber(server.playing)
            local maxPlayers = tonumber(server.maxPlayers)
            local ping = tonumber(server.ping)

            if server.id
                and server.id ~= game.JobId
                and playing
                and maxPlayers
                and playing < maxPlayers
                and playing <= 3 then

                table.insert(servers, {
                    id = server.id,
                    playing = playing,
                    maxPlayers = maxPlayers,
                    ping = ping or 9999,
                })
            end
        end

        cursor = response.nextPageCursor
    until #servers >= 20 or not cursor or cursor == "" or pages >= 4

    table.sort(servers, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing
        end
        return a.ping < b.ping
    end)

    return servers
end

local function findBrazilOrientedServer()
    local servers = getPublicServersForFinder()
    if #servers == 0 then
        return nil
    end

    -- Prefer an almost-empty server, then the lowest reported ping.
    local best = servers[1]
    for i = 1, math.min(#servers, 12) do
        local candidate = servers[i]
        if candidate.playing < best.playing then
            best = candidate
        elseif candidate.playing == best.playing and candidate.ping < best.ping then
            best = candidate
        end
    end
    return best
end

-- ============================================================
-- INSTANT RESET — AMBITIOUS SYSTEM
-- ============================================================
-- V1 = HipHeight + fallback Health=0
-- V2 = Physics/vertical fling
-- Camera stays frozen until the new character is actually ready.
-- AntiDie/AntiRagdoll are paused only for the reset window and restored
-- to the exact state they had before pressing RESET.

do
    local IR = {
        busy = false,
        gaveUp = false,
        oldChar = nil,
        camConn = nil,
        camSaved = nil,
        version = math.clamp(tonumber(savedSettings.instantResetVersion) or 1, 1, 2),
    }

    local function waitCharacterReady(character, timeout)
        if not character then return false end
        local deadline = os.clock() + (tonumber(timeout) or 8)
        while os.clock() < deadline do
            if not character.Parent then return false end
            if LocalPlayer.Character ~= character then return false end
            local hum = character:FindFirstChildOfClass("Humanoid")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return true
            end
            task.wait(0.05)
        end
        return false
    end

    local function unlockResetCamera()
        if IR.camConn then
            pcall(function() IR.camConn:Disconnect() end)
            IR.camConn = nil
        end

        local saved = IR.camSaved
        IR.camSaved = nil
        if not saved then return end

        local cam = Workspace.CurrentCamera
        if not cam then return end
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            cam.CameraType = saved.type or Enum.CameraType.Custom
            cam.CameraSubject = hum or saved.subject
        end)
    end

    local function lockResetCamera()
        local cam = Workspace.CurrentCamera
        if not cam then return end

        unlockResetCamera()

        IR.camSaved = {
            cframe = cam.CFrame,
            type = cam.CameraType,
            subject = cam.CameraSubject,
        }

        cam.CameraType = Enum.CameraType.Scriptable
        IR.camConn = RunService.RenderStepped:Connect(function()
            local c = Workspace.CurrentCamera
            local saved = IR.camSaved
            if not c or not saved then return end
            pcall(function()
                c.CameraType = Enum.CameraType.Scriptable
                c.CFrame = saved.cframe
            end)
        end)
    end

    local function instantResetV2()
        IR.gaveUp = false
        local character = LocalPlayer.Character
        if not character then IR.gaveUp = true return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then IR.gaveUp = true return end

        local savedPlatform = humanoid.PlatformStand
        local savedBreak = humanoid.BreakJointsOnDeath
        local BURST, WINDOW = 500, 0.3
        local FLING = 1e9

        local function applyFling(hum, r)
            hum.BreakJointsOnDeath = true
            hum.PlatformStand = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            r.AssemblyAngularVelocity = Vector3.zero
            r.AssemblyLinearVelocity = Vector3.new(0, FLING, 0)
        end

        local function attempt()
            local ch = LocalPlayer.Character
            if ch ~= character or not character.Parent then return false end
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return false end
            local r = ch:FindFirstChild("HumanoidRootPart")
            if r then pcall(applyFling, hum, r) end
            return true
        end

        local t0 = os.clock()
        for _ = 1, BURST do
            if not attempt() then return end
        end

        while os.clock() - t0 < WINDOW do
            RunService.Heartbeat:Wait()
            if not attempt() then return end
        end

        if not character.Parent or LocalPlayer.Character ~= character then return end
        if humanoid.Health <= 0 then return end

        IR.gaveUp = true
        pcall(function()
            humanoid.PlatformStand = savedPlatform
            humanoid.BreakJointsOnDeath = savedBreak
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local function instantResetV1()
        IR.gaveUp = false
        local character = LocalPlayer.Character
        if not character then IR.gaveUp = true return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then IR.gaveUp = true return end

        local originalHipHeight = humanoid.HipHeight
        local attempts = 0
        local done = false

        while character and character.Parent and humanoid
              and humanoid.Health > 0 and LocalPlayer.Character == character
              and attempts < 40 do
            pcall(function()
                humanoid.HipHeight = 1e30
                humanoid.AutoRotate = true
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)

            if not character.Parent or humanoid.Health <= 0 or LocalPlayer.Character ~= character then
                done = true
                break
            end

            attempts += 1
            task.wait(0.05)
        end

        if not done and character and character.Parent and humanoid and humanoid.Health > 0 then
            pcall(function()
                humanoid.BreakJointsOnDeath = true
                humanoid.RequiresNeck = true
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                humanoid.Health = 0
            end)
            task.wait(0.1)
            if not character.Parent or humanoid.Health <= 0 or LocalPlayer.Character ~= character then
                done = true
            end
        end

        if not done then
            IR.gaveUp = true
            if character and character.Parent and humanoid then
                pcall(function()
                    humanoid.HipHeight = originalHipHeight
                    for _, part in ipairs(character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end)
            end
        end
    end

    local function runInstantResetMethod()
        if IR.version == 2 then
            instantResetV2()
        else
            instantResetV1()
        end
    end

    _G.AmbitiousInstantResetVersion = IR.version
    _G.AmbitiousSetInstantResetVersion = function(version)
        version = math.clamp(tonumber(version) or 1, 1, 2)
        IR.version = version
        _G.AmbitiousInstantResetVersion = version
        savedSettings.instantResetVersion = version
        pcall(saveSettings)
        return version
    end

    _G.AmbitiousInstantReset = function()
        if IR.busy then return end
        if not LocalPlayer.Character then return end
        IR.busy = true
        IR.gaveUp = false
        IR.oldChar = LocalPlayer.Character

        local previousAntiDieDisabled = _G.AntiDieDisabled
        local previousAntiRagdoll = antiRagdollEnabled

        -- Pause only the protections that can cancel the death/reset.
        _G.AntiDieDisabled = true
        antiRagdollEnabled = false

        lockResetCamera()

        task.spawn(function()
            pcall(runInstantResetMethod)
        end)

        task.spawn(function()
            local oldChar = IR.oldChar
            local deadline = os.clock() + 25
            local ready = false

            while os.clock() < deadline do
                if IR.gaveUp then break end
                local ch = LocalPlayer.Character
                if ch and ch.Parent and ch ~= oldChar then
                    if waitCharacterReady(ch, 8) then
                        ready = true
                        break
                    end
                end
                task.wait(0.05)
            end

            unlockResetCamera()
            _G.AntiDieDisabled = previousAntiDieDisabled
            antiRagdollEnabled = previousAntiRagdoll
            IR.busy = false
        end)
    end

end

