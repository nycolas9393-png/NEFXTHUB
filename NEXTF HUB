        dot.Size = UDim2.new(0, 18 * SCALE, 0, 18 * SCALE)
        dot.Position = isOn
            and UDim2.new(1, -20 * SCALE, 0.5, -9 * SCALE)
            or  UDim2.new(0,   2 * SCALE, 0.5, -9 * SCALE)
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
