-- SPEED BOOSTER + INSTANT RESET
-- X is reserved for Instant Reset so the reset keybind is reliable.
-- Speed Booster defaults to B and remains fully rebindable in KEYBINDS.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if U.rebinding or U.boosterRebinding or U.resetRebinding then return end

    local boosterBound = _G.KEYBIND_BOOSTER or KEYBIND_BOOSTER
    local resetBound = _G.KEYBIND_RESET or KEYBIND_RESET

    if resetBound ~= Enum.KeyCode.Unknown and input.KeyCode == resetBound then
        task.spawn(function()
            if _G.AmbitiousInstantReset then
                pcall(_G.AmbitiousInstantReset)
            end
        end)
        return
    end

    if gameProcessed then return end

    if boosterBound ~= Enum.KeyCode.Unknown and input.KeyCode == boosterBound then
        if _G.XKPubToggleSpeedBoosterKey then
            local state = _G.XKPubToggleSpeedBoosterKey()
            if U.speedBtn then
                U.speedBtn.Text = state and "ATIVADO" or "DESLIGADO"
            end
        end
    end
end)

