        lbl.Position = UDim2.new(0, 10 * SCALE, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12 * SCALE
        lbl.TextColor3 = C_TEXT
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local isOn = default and true or false
        local tf = Instance.new("Frame", row)
        tf.Size = UDim2.new(0, 44 * SCALE, 0, 22 * SCALE)
        tf.Position = UDim2.new(1, -52 * SCALE, 0.5, -11 * SCALE)
        tf.BackgroundColor3 = isOn and C_ON or C_OFF
        tf.BorderSizePixel = 0
        corner(tf, 999)

