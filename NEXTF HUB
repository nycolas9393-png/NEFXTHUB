        if _G.JAF_InvisFold ~= false then task.wait(0.05); animationTrickery() end

        local lastSetPosition = nil
        local skipFrames      = 5
        local _invisFastMode  = false
        local _invisSlowAccum = 0

        connection = RunService.PreSimulation:Connect(function(_psDt)
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and oldRoot then
                local root = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
                if root then
