local function animateActivation(btn)
    if not btn or not btn.Parent then return end
    local scale = btn:FindFirstChild("ActivationScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "ActivationScale"
        scale.Scale = 1
        scale.Parent = btn
    end
    scale.Scale = 0.96
    TweenService:Create(
        scale,
        TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Scale = 1.06}
    ):Play()
    task.delay(0.16, function()
        if scale and scale.Parent then
            TweenService:Create(
                scale,
                TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Scale = 1}
            ):Play()
        end
    end)
end

local function animateRowState(row, active)
    if not row or not row.Parent then return end
    local stroke = row:FindFirstChild("ActivationStroke")
    if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Name = "ActivationStroke"
        stroke.Thickness = 1
        stroke.Transparency = 1
        stroke.Parent = row
    end
    stroke.Color = UI_PURPLE_BORDER
    TweenService:Create(
        stroke,
        TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Transparency = active and 0.08 or 0.55}
    ):Play()
end

local function rowButton(parent, name, order, state, callback, purple, fixedText, height)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,height or 27)
    row.LayoutOrder = order
    row.BackgroundColor3 = UI_ROW
    row.BorderSizePixel = 0
    row.ZIndex = 110
