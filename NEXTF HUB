local function triggerHoldBegan(
    prompt
)

    if not prompt then
        return
    end

    if getconnections then

        for _, conn in ipairs(
            getconnections(
                prompt.PromptButtonHoldBegan
            )
        ) do

            if conn.Function then

                task.spawn(
                    conn.Function
                )
            end
        end

    else

        prompt:InputHoldBegan()
    end
end

