                    if _G.JAF_InvisRagdollGuard ~= false then
                        pcall(function()
                            if (LocalPlayer:GetAttribute("RagdollEndTime") or 0) > 0 then
                                LocalPlayer:SetAttribute("RagdollEndTime", 0)
                            end
                            local _h = char:FindFirstChildOfClass("Humanoid")
                            if _h then
                                if _h.PlatformStand then _h.PlatformStand = false end
                                local _s = _h:GetState()
                                if _s == Enum.HumanoidStateType.Physics
                                or _s == Enum.HumanoidStateType.Ragdoll
                                or _s == Enum.HumanoidStateType.FallingDown then
                                    _h:ChangeState(Enum.HumanoidStateType.GettingUp)
                                end
                            end
                            if invisRagdollACChar ~= char then
                                invisRagdollACChar = char; invisRagdollACs = {}
                                for _, d in ipairs(char:GetDescendants()) do
                                    if d:IsA("AnimationConstraint") then table.insert(invisRagdollACs, d) end
                                end
                            end
                            for _, ac in ipairs(invisRagdollACs) do
                                if ac.Parent and not ac.Enabled then ac.Enabled = true end
                            end
                        end)
                    end

                    -- lagback detect
                    if skipFrames > 0 then
                        skipFrames = skipFrames - 1; lastSetPosition = nil
                    elseif lastSetPosition and ghostEnabled then
                        local currentPos  = oldRoot.Position
                        local jumpDist    = (currentPos - lastSetPosition).Magnitude
                        if jumpDist > 16 and not _G.RecoveryInProgress
                        and LocalPlayer:GetAttribute("Stealing")
                        and not autoInvisBlocked()
                        and (tick() - (_G.__lastAutoRecoverT or 0)) > 1.5 then
                            _G.__lastAutoRecoverT = tick()
                            lastSetPosition = nil; createServerGhost(currentPos)
                            if _G.AutoRecoverLagback and _G.setInvisibleSteal then
                                _G.RecoveryInProgress = true
                                local _recChar = LocalPlayer.Character
                                task.spawn(function()
                                    pcall(_G.setInvisibleSteal, false)
                                    task.wait(0.6)
                                    if LocalPlayer.Character == _recChar
                                    and LocalPlayer:GetAttribute("Stealing")
                                    and not autoInvisBlocked() then
                                        pcall(_G.setInvisibleSteal, true)
                                    end
                                    _G.RecoveryInProgress = false
                                end)
                            end
                        end
                    end

                    if clone then clone.CanCollide = (_G.JAF_InvisCloneCollide ~= false) end
                    if not oldRoot then return end
                    for _, c in pairs(oldRoot:GetChildren()) do
                        if c:IsA("Beam") or (c:IsA("Attachment") and c.Name:find("Beam")) then c:Destroy() end
                    end

                    -- ==================================================
                    --  DEPTH + ROTATION
                    -- ==================================================
                    local rotAngle = (_G.AutoRotateInvis and _G.CurrentInvisRotation)
                        or _G.InvisStealAngle or 225
                    local sa = math.clamp(tonumber(_G.SinkSliderValue) or 8, 5, 10) * 0.5

                    local _rv    = root.AssemblyLinearVelocity
                    local _xzSpd = Vector3.new(_rv.X, 0, _rv.Z).Magnitude
                    local _hyDt  = tonumber(_psDt) or (1/60)

                    if _invisFastMode then
                        if _xzSpd < (_G.JAF_InvisFastExit or 17) then
                            _invisSlowAccum = _invisSlowAccum + _hyDt
                            if _invisSlowAccum > 0.15 then _invisFastMode = false end
                        else
                            _invisSlowAccum = 0
                        end
                    elseif _xzSpd > (_G.JAF_InvisFastEnter or 22) then
                        _invisFastMode = true; _invisSlowAccum = 0
                    end

                    if _invisFastMode and _G.JAF_InvisSpeedFix ~= false and not _G.JAF_InvisSurface then
                        if not _invisSF or _invisSF.Parent ~= oldRoot then
                            if _invisSF    then pcall(function() _invisSF:Destroy()    end) end
                            if _invisSFAtt then pcall(function() _invisSFAtt:Destroy() end) end
                            _invisSFAtt = Instance.new("Attachment")
                            _invisSFAtt.Name   = "InvisLVAtt"
                            _invisSFAtt.Parent = oldRoot
                            _invisSF = Instance.new("LinearVelocity")
                            _invisSF.Name                   = "InvisSpeedForce"
                            _invisSF.Attachment0            = _invisSFAtt
                            _invisSF.RelativeTo             = Enum.ActuatorRelativeTo.World
                            _invisSF.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
                            _invisSF.ForceLimitMode         = Enum.ForceLimitMode.PerAxis
                            _invisSF.MaxAxesForce           = Vector3.new(math.huge, math.huge, math.huge)
                            _invisSF.Parent                 = oldRoot
                        end
                        local _yv = math.clamp(
                            ((root.Position.Y - sa) - oldRoot.Position.Y) * (_G.JAF_InvisYGain or 25),
                            -150, 150)
                        local _gx = _G.JAF_InvisXZGain or 8
                        local _vx = _rv.X + math.clamp((root.Position.X - oldRoot.Position.X) * _gx, -15, 15)
                        local _vz = _rv.Z + math.clamp((root.Position.Z - oldRoot.Position.Z) * _gx, -15, 15)
                        local _hv = Vector3.new(_vx, 0, _vz)
                        local _mxz = _G.JAF_InvisMaxXZ or 65
                        if _hv.Magnitude > _mxz then _hv = _hv.Unit * _mxz end
                        _invisSF.VectorVelocity = Vector3.new(_hv.X, _yv, _hv.Z)
                        _invisSF.Enabled        = true
                        oldRoot.CFrame = CFrame.new(oldRoot.Position)
                            * root.CFrame.Rotation
                            * CFrame.Angles(math.rad(rotAngle), 0, 0)
                        oldRoot.CanCollide = false
                    else
                        if _invisSF and _invisSF.Enabled then _invisSF.Enabled = false end
                        local cf = root.CFrame - Vector3.new(0, sa, 0)
                        oldRoot.CFrame = cf * CFrame.Angles(math.rad(rotAngle), 0, 0)
                        if _G.JAF_InvisSurface then oldRoot.CFrame = root.CFrame end
                        oldRoot.AssemblyLinearVelocity = root.AssemblyLinearVelocity
                        oldRoot.CanCollide = false
                    end
                    lastSetPosition = _G.JAF_InvisSurface and nil or oldRoot.Position
                end
            end
        end)
        return true
    end

    -- ============================================================
    --  API PÚBLICA
    -- ============================================================
    local function toggle()
        if _G.invisibleStealEnabled then invisTurnOff() else removeFolders(); invisTurnOn() end
    end

    _G.toggleInvisibleSteal = function()
        if (tick() - _invisToggleCooldown) < 0.3 then return end
        toggle()
    end
    _G._forceInvisToggle = toggle
    _G.setInvisibleSteal = function(on)
        on = on and true or false
        if on and not _G.invisibleStealEnabled then removeFolders(); invisTurnOn()
        elseif (not on) and _G.invisibleStealEnabled then invisTurnOff() end
    end
    _G.forceToggleInvisibleSteal = function(wantOn)
        if wantOn and not animPlaying then invisTurnOn()
        elseif not wantOn and animPlaying then invisTurnOff() end
    end

    -- ============================================================
    --  AUTO-INVIS DURANTE STEAL
    -- ============================================================
    local function invisEngaged()
        return animPlaying == true
           and connection ~= nil
           and oldRoot ~= nil and oldRoot.Parent ~= nil
           and clone   ~= nil and clone.Parent   ~= nil
    end
    local function charReadyForInvis()
        local ch = LocalPlayer.Character
        if not ch or ch.Parent == nil then return false end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local hrp = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
        return (hum and hum.Health > 0 and hrp and hrp.Parent) and true or false
    end

    local _vxStealingConn = LocalPlayer:GetAttributeChangedSignal("Stealing"):Connect(function()
        if not LocalPlayer:GetAttribute("Stealing") then clearInvisSuppress() end
    end)

    task.spawn(function()
        local streakStart, offSince, lastTry, failStreak = nil, nil, 0, 0
        while _G.VXInvisLoopAlive ~= false do
            RunService.Heartbeat:Wait()
            pcall(function()
                local auto = _G.AutoInvisDuringSteal == true
                if not auto then
                    streakStart, offSince = nil, nil
                    failStreak = 0
                    _autoInvisOwned = false
                    return
                end
                if LocalPlayer:GetAttribute("Stealing") == true then
                    offSince = nil
                    streakStart = streakStart or tick()
                    if invisEngaged() then
                        _autoInvisOwned = true
                        failStreak = 0
                        return
                    end
                    if autoInvisBlocked() then return end
                    if _G.RecoveryInProgress then return end

                    local delay = math.clamp(tonumber(_G.AutoInvisDelay) or 0.3, 0, 3)
                    if (tick() - streakStart) < delay then return end

                    local gap = (failStreak >= 4) and 0.5 or 0.12
                    if tick() - lastTry < gap then return end
                    lastTry = tick()

                    if animPlaying or _G.invisibleStealEnabled then pcall(invisTurnOff) end
                    if charReadyForInvis() then
                        pcall(removeFolders)
                        local ok, res = pcall(invisTurnOn)
                        if ok and res == true and _G.invisibleStealEnabled then
                            _autoInvisOwned = true; failStreak = 0
                        else
                            failStreak = failStreak + 1
                        end
                    end
                else
                    failStreak = 0
                    if streakStart or animPlaying or _G.invisibleStealEnabled then
                        offSince = offSince or tick()
                        local grace = math.clamp(tonumber(_G.AutoInvisGrace) or 0.3, 0.1, 3)
                        if tick() - offSince >= grace then
                            if (animPlaying or _G.invisibleStealEnabled) and _autoInvisOwned then
                                pcall(invisTurnOff)
                            end
                            streakStart, offSince = nil, nil
                            _autoInvisOwned = false
                        end
                    end
                end
            end)
        end
    end)

