-- Guaranteed reset key listener lives outside the isolated UI chunk, so X
-- still works even if a UI element is closed/rebuilt. It always uses the
-- current rebind value and the same Ambitious reset function as the RESET button.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if _G.U and (U.rebinding or U.boosterRebinding or U.resetRebinding) then return end
    local resetBound = _G.KEYBIND_RESET or KEYBIND_RESET
    if resetBound ~= Enum.KeyCode.Unknown and input.KeyCode == resetBound then
        if _G.AmbitiousInstantReset then
            task.spawn(function() pcall(_G.AmbitiousInstantReset) end)
        end
    end
end)

