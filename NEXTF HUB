local function esfStartSearch()
    if emptyFinderBusy then return end
    emptyFinderBusy = true
    esfSet("SEARCHING...", "FINDING A LOW-POPULATION SERVER", "SEARCHING...", false)

    task.spawn(function()
        local target = findBrazilOrientedServer()
        emptyFinderTarget = target

        if not target then
            emptyFinderBusy = false
            emptyFinderTarget = nil
            esfSet("NO SERVER FOUND", "TRY AGAIN IN A FEW SECONDS", "SEARCH AGAIN", true)
            return
        end

        local pingText = target.ping >= 9999 and "--" or tostring(math.floor(target.ping))
        esfSet("SERVER FOUND", string.format("%d PLAYER(S) • EST. %sMS", target.playing, pingText), "TELEPORTING...", false, false)

        task.wait(0.55)
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
        end)

        task.delay(5, function()
            emptyFinderBusy = false
        end)
    end)
end

