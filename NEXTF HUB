-- ============================================================

local function triggerPrompt(
    prompt
)

    if not prompt then
        return
    end

    if getconnections then

        for _, conn in ipairs(
            getconnections(
                prompt.Triggered
            )
        ) do

            if conn.Function then

                task.spawn(
                    conn.Function
                )
            end
        end

    else

        prompt:InputHoldEnded()
    end
end

